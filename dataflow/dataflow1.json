{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedTextDataFlowSource",
						"type": "DatasetReference"
					},
					"name": "sourceCSV"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "selectcolumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          InvoiceNo as string,",
				"          StockCode as string,",
				"          Description as string,",
				"          Quantity as short,",
				"          InvoiceDate as timestamp,",
				"          UnitPrice as double,",
				"          CustomerID as double,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCSV",
				"sourceCSV select(mapColumn(",
				"          InvoiceNo,",
				"          StockCode,",
				"          Description,",
				"          Quantity,",
				"          InvoiceDate,",
				"          UnitPrice,",
				"          CustomerID,",
				"          Country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectcolumns"
			]
		}
	}
}